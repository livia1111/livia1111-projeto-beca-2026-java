# Credenciais do PostgreSQL (usadas por ambos os bancos)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Nomes dos bancos
MS1_DB_NAME=ms1_db
MS2_DB_NAME=ms2_db

# Portas no host (para evitar conflito com outros projetos locais)
MS1_APP_PORT=8080
MS2_APP_PORT=8082
MS1_DB_PORT=5433
MS2_DB_PORT=5434